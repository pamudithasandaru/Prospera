# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend origin (CORS + Socket.IO). The dev client runs on 3001.
CLIENT_URL=http://localhost:3001

# ─── Database — Neon PostgreSQL ───────────────────────────────────────────────
# Get both strings from the Neon console → your project → Connection Details.
#
# DATABASE_URL  → the POOLED connection (host contains "-pooler"). Used at runtime.
# DIRECT_URL    → the DIRECT connection (no "-pooler"). Used by Prisma Migrate,
#                 which needs a session connection to run DDL.
#
# Keep sslmode=require on both.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=30d

# Super admin. Credentials live here, never in the database.
# Login is disabled if either value is empty.
SUPERADMIN_EMAIL=superadmin@prospera.lk
SUPERADMIN_PASSWORD=change-me-to-a-strong-password

# Seeded demo account (development only) — used by prisma/seed.js.
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL=demo@prospera.lk
DEMO_PASSWORD=Prospera123!

# ─── Third-party services ─────────────────────────────────────────────────────
# All optional for local development. Supply your own credentials — never
# commit real keys to this file.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Only needed for the marketplace webhook. Local dev: run
#   stripe listen --forward-to localhost:5000/api/marketplace/webhook
# and paste the whsec_... it prints.
STRIPE_WEBHOOK_SECRET=

# Weather uses Open-Meteo (free, no API key needed).

# Python ML service (plant disease detection)
ML_SERVICE_URL=http://localhost:8000
